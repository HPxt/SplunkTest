{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🌐 Flask: Backend Web",
            "type": "python",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--host=0.0.0.0",
                "--port=5000"
            ],
            "cwd": "${workspaceFolder}/splunk-siem-mvp/web/backend",
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "🖥️ SIEM: CLI Full Pipeline",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/splunk-siem-mvp/siem_main.py",
            "args": [
                "--full",
                "--count",
                "100"
            ],
            "cwd": "${workspaceFolder}/splunk-siem-mvp",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🔍 SIEM: Query SPL",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/splunk-siem-mvp/siem_main.py",
            "args": [
                "--query",
                "search http | stats count by status_code"
            ],
            "cwd": "${workspaceFolder}/splunk-siem-mvp",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "📊 SIEM: Generate Logs Only",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/splunk-siem-mvp/siem_main.py",
            "args": [
                "--generate-logs",
                "--count",
                "500"
            ],
            "cwd": "${workspaceFolder}/splunk-siem-mvp",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🔬 SIEM: Analyze Only",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/splunk-siem-mvp/siem_main.py",
            "args": [
                "--analyze"
            ],
            "cwd": "${workspaceFolder}/splunk-siem-mvp",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
